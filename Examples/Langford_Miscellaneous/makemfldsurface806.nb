Cell[BoxData[{
 RowBox[{
  RowBox[{"F1", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"z", "-", " ", "beta"}], ")"}], " ", "x"}], "-", " ", 
   RowBox[{"delta", " ", "y"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F2", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"delta", " ", "x"}], " ", "+", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"z", "-", "beta"}], ")"}], " ", "y"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F3", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", 
   RowBox[{"gamma", " ", "+", " ", 
    RowBox[{"alpha", " ", "z"}], " ", "-", " ", 
    RowBox[{
     RowBox[{"z", "^", "3"}], "/", "3"}], " ", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"epsilon", " ", "z"}]}], ")"}]}], " ", "+", " ", 
    RowBox[{"zeta", " ", "z", " ", 
     RowBox[{"x", "^", "3"}]}]}]}], ";"}]}], "Input",
