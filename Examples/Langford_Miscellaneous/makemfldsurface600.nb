     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "50"}], "}"}], ",", 
     RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
