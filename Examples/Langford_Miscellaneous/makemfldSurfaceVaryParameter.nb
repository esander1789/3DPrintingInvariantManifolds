Cell[BoxData[{
 RowBox[{
  RowBox[{"timelengthc", " ", "=", " ", 
   RowBox[{"timelengtha", " ", "numits"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ap", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
