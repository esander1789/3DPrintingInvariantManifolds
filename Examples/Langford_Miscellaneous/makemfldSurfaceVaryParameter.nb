Cell[BoxData[{
 RowBox[{
  RowBox[{"F1", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"z", "-", " ", "beta"}], ")"}], " ", "x"}], "-", " ", 
   RowBox[{"delta", " ", "y"}]}]}], "\[IndentingNewLine]", 
