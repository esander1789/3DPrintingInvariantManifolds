Cell[BoxData[
 RowBox[{"Monitor", "[", 
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"flowa", "[", 
        RowBox[{"f1", ",", "g1", ",", "h1"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xaFn", ",", "yaFn", ",", "zaFn"}], "}"}], "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"xa", ",", "ya", ",", "za"}], "}"}], "/.", " ", 
        RowBox[{"First", "[", "sol", "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"fdata", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"xaFn", "[", 
          RowBox[{"timelengthc", ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xdata2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"gdata", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"yaFn", "[", 
          RowBox[{"timelengthc", ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xdata2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hdata", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"zaFn", "[", 
          RowBox[{"timelengthc", ",", "x"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "xdata2"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"currentCurve", "=", 
       RowBox[{"{", 
        RowBox[{"fdata", ",", "gdata", ",", "hdata"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"redistributedCurve", "=", 
       RowBox[{"redistributePoints", "[", "currentCurve", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"f1", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"xdata2", ",", 
           RowBox[{"redistributedCurve", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"g1", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"xdata2", ",", 
           RowBox[{"redistributedCurve", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"h1", "=", 
       RowBox[{"Interpolation", "[", 
        RowBox[{"Thread", "[", 
         RowBox[{"{", 
          RowBox[{"xdata2", ",", 
           RowBox[{"redistributedCurve", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"triples", "=", 
       RowBox[{"Transpose", "[", "redistributedCurve", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"fundat", ",", "triples"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "numlong"}], "}"}]}], "]"}], ",", "j"}], 
  "]"}]], "Input",
