        RowBox[{"L1", "/", "Lnorm"}], ",", 
        RowBox[{"L2", "/", "Lnorm"}], ",", 
        RowBox[{"L3", "/", "Lnorm"}], ",", 
        RowBox[{"1", "/", "Lnorm"}]}], "}"}]}]}], "]"}]}]}]], "Input",
