Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Add", " ", "arc", " ", "length", " ", "redistribution", " ", "function"}],
    "*)"}], 
  RowBox[{
   RowBox[{"redistributePoints", "[", "curve_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "diffs", ",", "segLengths", ",", "cumLength", ",", "totalLength", ",", 
       "targetLengths", ",", "newPoints"}], "}"}], ",", 
     RowBox[{
      RowBox[{"diffs", "=", 
       RowBox[{"Differences", "[", 
        RowBox[{"Transpose", "[", "curve", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"segLengths", "=", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"diffs", "^", "2"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"cumLength", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", "segLengths", "]"}], ",", "0"}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"totalLength", "=", 
       RowBox[{"Last", "[", "cumLength", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"targetLengths", "=", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", 
          RowBox[{"numpoints", "-", "1"}]}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{"totalLength", "/", 
          RowBox[{"(", 
           RowBox[{"numpoints", "-", "1"}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"newPoints", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"idx", ",", "frac"}], "}"}], ",", 
           RowBox[{
            RowBox[{"idx", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"1", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"FirstPosition", "[", 
                  RowBox[{"cumLength", ",", 
                   RowBox[{"_", "?", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#", ">=", "t"}], "&"}], ")"}]}]}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"frac", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t", "-", 
                RowBox[{"cumLength", "[", 
                 RowBox[{"[", "idx", "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"cumLength", "[", 
                 RowBox[{"[", 
                  RowBox[{"idx", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"cumLength", "[", 
                 RowBox[{"[", "idx", "]"}], "]"}]}], ")"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "frac"}], ")"}], "*", 
              RowBox[{"curve", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "idx"}], "]"}], "]"}]}], "+", 
             RowBox[{"frac", "*", 
              RowBox[{"curve", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", 
                 RowBox[{"idx", "+", "1"}]}], "]"}], "]"}]}]}]}]}], "]"}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "targetLengths"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", "newPoints", "]"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.940326193677532*^9, 3.940326223804541*^9}, {
