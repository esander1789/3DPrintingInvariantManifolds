Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Lorenz", " ", "Vector", " ", "Field"}], "*)"}], 
  RowBox[{
   RowBox[{"lorenzSystem", "[", 
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_", ",", "w_"}], "}"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"L1", ",", "L2", ",", "L3", ",", "Lnorm"}], "}"}], ",", 
     RowBox[{
      RowBox[{"L1", "=", 
       RowBox[{"sigma", "*", 
        RowBox[{"(", 
         RowBox[{"y", "-", "x"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"L2", "=", 
       RowBox[{
        RowBox[{"x", "*", 
         RowBox[{"(", 
          RowBox[{"rho", "-", "z"}], ")"}]}], "-", "y"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"L3", "=", 
       RowBox[{
        RowBox[{"x", "*", "y"}], "-", 
        RowBox[{"beta", "*", "z"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Lnorm", "=", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"L1", "^", "2"}], "+", 
           RowBox[{"L2", "^", "2"}], "+", 
           RowBox[{"L3", "^", "2"}]}], "]"}]}], ";"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Lnorm", " ", "=", " ", "1"}], ";", " ", "\[IndentingNewLine]", 
      
      RowBox[{"{", 
