Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Modified", " ", "flow", " ", "function"}], "*)"}], 
  RowBox[{
   RowBox[{"flowa", "[", 
    RowBox[{"f_", ",", "g_", ",", "h_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "sol", "}"}], ",", 
     RowBox[{
      RowBox[{"sol", "=", 
       RowBox[{"NDSolve", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"xa", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], ",", 
                RowBox[{"ya", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], ",", 
                RowBox[{"za", "[", 
                 RowBox[{"t", ",", "x"}], "]"}], ",", 
                RowBox[{"wa", "[", 
                 RowBox[{"t", ",", "x"}], "]"}]}], "}"}], ",", "t"}], "]"}], "==", 
            RowBox[{"lorenzSystem", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"xa", "[", 
                RowBox[{"t", ",", "x"}], "]"}], ",", 
               RowBox[{"ya", "[", 
                RowBox[{"t", ",", "x"}], "]"}], ",", 
               RowBox[{"za", "[", 
                RowBox[{"t", ",", "x"}], "]"}], ",", 
               RowBox[{"wa", "[", 
                RowBox[{"t", ",", "x"}], "]"}]}], "}"}], "]"}]}], ",", 
           RowBox[{
            RowBox[{"xa", "[", 
             RowBox[{"0", ",", "x"}], "]"}], "==", 
            RowBox[{"f", "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"ya", "[", 
             RowBox[{"0", ",", "x"}], "]"}], "==", 
            RowBox[{"g", "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"za", "[", 
             RowBox[{"0", ",", "x"}], "]"}], "==", 
            RowBox[{"h", "[", "x", "]"}]}], ",", 
           RowBox[{
            RowBox[{"wa", "[", 
             RowBox[{"0", ",", "x"}], "]"}], "==", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"xa", ",", "ya", ",", "za", ",", "wa"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "timelengthc"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"Method", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<MethodOfLines\>\"", ",", 
            RowBox[{"\"\<SpatialDiscretization\>\"", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<TensorProductGrid\>\"", ",", 
               RowBox[{"\"\<MinPoints\>\"", "->", "100"}]}], "}"}]}]}], 
           "}"}]}], ",", 
         RowBox[{"PrecisionGoal", "->", "8"}], ",", 
         RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "sol"}]}], "]"}]}]}]], "Input",
