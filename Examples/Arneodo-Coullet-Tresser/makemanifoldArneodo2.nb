Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"timelengthc", " ", "=", " ", 
     RowBox[{"timelengtha", " ", "numits"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ap", " ", "=", " ", 
     RowBox[{"NDSolve", "[", 
      RowBox[{
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"xa", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
          RowBox[{"F1", "[", 
           RowBox[{
            RowBox[{"xa", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"ya", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"za", "[", 
             RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"ya", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
          RowBox[{"F2", "[", 
           RowBox[{
            RowBox[{"xa", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"ya", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"za", "[", 
             RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"za", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
          RowBox[{"F3", "[", 
           RowBox[{
            RowBox[{"xa", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"ya", "[", 
             RowBox[{"t", ",", "x"}], "]"}], ",", 
            RowBox[{"za", "[", 
             RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"xa", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "==", " ", 
          RowBox[{"f0", "[", "x", "]"}]}], " ", ",", 
         RowBox[{
          RowBox[{"ya", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", 
          RowBox[{"g0", "[", "x", "]"}]}], ",", 
         RowBox[{
          RowBox[{"za", "[", 
           RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", 
          RowBox[{"h0", "[", "x", "]"}]}]}], "}"}], ",", 
