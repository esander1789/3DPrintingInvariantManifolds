Cell[BoxData[{
 RowBox[{
  RowBox[{"F1", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "-", " ", "beta"}], ")"}], " ", "x"}], "-", " ", 
     RowBox[{"delta", " ", "y"}]}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F2", "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{"-", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"delta", " ", "x"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"z", "-", "beta"}], ")"}], " ", "y"}]}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"F3", "[", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"gamma", " ", "+", " ", 
      RowBox[{"alpha", " ", "z"}], " ", "-", " ", 
      RowBox[{
       RowBox[{"z", "^", "3"}], "/", "3"}], " ", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"epsilon", " ", "z"}]}], ")"}]}], " ", "+", " ", 
      RowBox[{"zeta", " ", "z", " ", 
       RowBox[{"x", "^", "3"}]}]}], ")"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.930228434410285*^9, 3.930228450238299*^9}},
 CellLabel->
  "In[196]:=",ExpressionUUID->"4879eeb8-6d64-4890-8ac7-73f55727f319"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", " ", "=", " ", "pt"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f0", "=", " ", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g0", " ", "=", " ", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h0", " ", "=", " ", 
   RowBox[{"Interpolation", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fundat", "  ", "=", 
    RowBox[{"{", 
     RowBox[{"f0", ",", "g0", ",", "h0"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timelengthc", " ", "=", " ", 
   RowBox[{"timelengtha", " ", "numits"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ap", " ", "=", " ", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"xa", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
        RowBox[{"F1", "[", 
         RowBox[{
          RowBox[{"xa", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"ya", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"za", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"ya", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
        RowBox[{"F2", "[", 
         RowBox[{
          RowBox[{"xa", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"ya", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"za", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"za", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", "t"}], "]"}], "\[Equal]", 
        RowBox[{"F3", "[", 
         RowBox[{
          RowBox[{"xa", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"ya", "[", 
           RowBox[{"t", ",", "x"}], "]"}], ",", 
          RowBox[{"za", "[", 
           RowBox[{"t", ",", "x"}], "]"}]}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"xa", "[", 
         RowBox[{"0", ",", "x"}], "]"}], "==", " ", 
        RowBox[{"f0", "[", "x", "]"}]}], " ", ",", 
       RowBox[{
        RowBox[{"ya", "[", 
         RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", 
        RowBox[{"g0", "[", "x", "]"}]}], ",", 
       RowBox[{
        RowBox[{"za", "[", 
         RowBox[{"0", ",", "x"}], "]"}], "\[Equal]", 
        RowBox[{"h0", "[", "x", "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"{", 
      RowBox[{"xa", ",", "ya", ",", "za"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "timelengthc"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "300"}], "}"}], ",", 
     RowBox[{"MaxSteps", "->", "Infinity"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.930227816578714*^9, 3.930227817334884*^9}, 
   3.938168197711191*^9, {3.9381691276775208`*^9, 3.938169131009783*^9}},
 CellLabel->
