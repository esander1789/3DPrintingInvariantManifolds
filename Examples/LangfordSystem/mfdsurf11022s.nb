  "In[183]:=",ExpressionUUID->"c2c9a275-4c60-47f2-95bd-059e20aae62f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"beta", "=", "0.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"delta", "=", "3.5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"gamma", "=", "0.6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zeta", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"epsilon", "=", "0.25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numits", " ", "=", " ", "23"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"scaling", " ", "=", " ", "25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"thicksurface", " ", "=", " ", "0.7"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"timelengtha", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numpoints", " ", "=", " ", "300"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numlong", " ", "=", " ", "50"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.930227783459577*^9, {3.930227887757028*^9, 3.9302279104254007`*^9}, {
   3.930227965437606*^9, 3.93022796721426*^9}, {3.930228099771968*^9, 
