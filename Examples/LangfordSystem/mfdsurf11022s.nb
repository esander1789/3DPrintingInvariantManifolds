Cell[BoxData[{
 RowBox[{
  RowBox[{"pt", " ", "=", " ", 
   RowBox[{"ReadList", "[", 
    RowBox[{"\"\<itstartpoints11022s.csv\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"Number", ",", "Number", ",", "Number"}], "}"}]}], "]"}]}], 
